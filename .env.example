# Токен от @BotFather
BOT_TOKEN=
# Публичный HTTPS-адрес Mini App (в dev — адрес ngrok/cloudflared туннеля на :8000)
WEBAPP_URL=https://example.com
# SQLite по умолчанию; в Docker используется Postgres
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# true — разрешает вход в API без Telegram (только для локальной разработки!)
DEV_AUTH=false
