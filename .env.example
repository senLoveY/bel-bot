# Токен от @BotFather
BOT_TOKEN=
# Публичный HTTPS-адрес Mini App (в продакшене — адрес проекта на Vercel)
WEBAPP_URL=https://example.com
# Локально — SQLite; в продакшене — Supabase Postgres (postgresql+asyncpg://...)
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# true — разрешает вход в API без Telegram (только для локальной разработки!)
DEV_AUTH=false
# Telegram ID админов через запятую
ADMIN_IDS=
# Vercel / serverless: бот через webhook, рассылка по внешнему крону
SERVERLESS=false
WEBHOOK_SECRET=
CRON_SECRET=
